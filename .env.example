# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cdms

# Application
APP_NAME=CDMS
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=cdms_session
# Local HTTP only. Set true for every HTTPS deployment.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=INFO

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
